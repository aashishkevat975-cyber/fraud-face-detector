{
  "expo": {
    "name": "Fraud Face Detector",
    "slug": "fraud-face-detector",
    "owner": "aashishkevat555",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b0f19"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.aashish.fraudfacedetector",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b0f19"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "a3f82b71-0000-0000-0000-000000000000"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you scan payment screenshots and QR codes for fraud detection."
        }
      ]
    ]
  }
}
